<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NETWORCO ID Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen flex flex-col text-gray-900">
    
    @if (ViewData["HideHeader"] == null)
    {
        <header class="bg-white/80 backdrop-blur-md border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">N</div>
                    <span class="text-xl font-bold text-gray-900">NETWORCO ID Admin</span>
                </div>
                <nav class="flex gap-6">
                    <a href="/Admin/Clients/Index" class="text-gray-600 hover:text-indigo-600 font-medium transition-colors">Clients</a>
                </nav>
                <div>
                    <span class="text-sm text-gray-500 font-medium bg-gray-100 px-3 py-1 rounded-full">Administrator</span>
                </div>
            </div>
        </header>
    }

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white/50 border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 py-6 text-center text-gray-500 text-sm">
            &copy; @DateTime.Now.Year NETWORCO. Internal System.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
