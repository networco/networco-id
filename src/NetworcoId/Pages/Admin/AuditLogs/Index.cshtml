@page
@model NetworcoId.Pages.Admin.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Audit Logs";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Audit Logs</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Comprehensive history of security events, system changes, and user activities.</p>
    </div>

    <!-- Filters Card -->
    <div class="mb-8 p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
        <div class="flex flex-col md:flex-row gap-4 items-center">
            <form method="get" class="flex-1 min-w-0 relative w-full">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search logs by description, user or IP..." 
                       class="block w-full pl-11 pr-4 py-3 rounded-xl border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-indigo-500 transition-all sm:text-sm" />
                <input type="hidden" name="EventType" value="@Model.EventType" />
            </form>

            <form method="get" class="flex items-center gap-3 w-full md:w-auto">
                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                <select name="EventType" onchange="this.form.submit()" 
                        class="block w-full md:w-auto rounded-xl border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white py-3 pl-4 pr-10 focus:ring-2 focus:ring-indigo-500 transition-all sm:text-sm font-bold uppercase tracking-wide">
                    <option value="">All Events</option>
                    @foreach (var type in Model.EventTypes)
                    {
                        <option value="@type" selected="@(Model.EventType == type)">@type</option>
                    }
                </select>
                
                @if (!string.IsNullOrEmpty(Model.EventType) || !string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="inline-flex items-center px-4 py-3 rounded-xl text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors">
                        Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Logs Table Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
                <thead>
                    <tr class="bg-gray-50/50 dark:bg-gray-900/20">
                        <th scope="col" class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Timestamp</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Event</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">User</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Description</th>
                        <th scope="col" class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
                    @foreach (var log in Model.Logs.Items)
                    {
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-900/40 transition-colors duration-150 group">
                            <td class="px-6 py-5 whitespace-nowrap">
                                <div class="text-sm font-bold text-gray-900 dark:text-white">@log.Timestamp.ToString("MMM dd, yyyy")</div>
                                <div class="text-[10px] font-bold text-gray-400 dark:text-gray-500 mt-0.5">@log.Timestamp.ToString("HH:mm:ss")</div>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap">
                                <span class="px-2.5 py-0.5 inline-flex text-[10px] font-bold uppercase tracking-wider rounded-lg border 
                                    @(log.EventType.Contains("Failed") ? "bg-red-50 text-red-700 border-red-100 dark:bg-red-900/20 dark:text-red-400 dark:border-red-800/30" : 
                                      log.EventType.Contains("Success") ? "bg-green-50 text-green-700 border-green-100 dark:bg-green-900/20 dark:text-green-400 dark:border-green-800/30" :
                                      "bg-indigo-50 text-indigo-700 border-indigo-100 dark:bg-indigo-900/20 dark:text-indigo-400 dark:border-indigo-800/30")">
                                    @log.EventType
                                </span>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap">
                                @if (log.User != null)
                                {
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-700 flex items-center justify-center text-[10px] font-extrabold text-indigo-600 dark:text-indigo-400 shadow-sm">
                                            @log.User.FirstName[0]@log.User.LastName[0]
                                        </div>
                                        <div>
                                            <div class="text-sm font-bold text-gray-900 dark:text-white">@log.User.FirstName @log.User.LastName</div>
                                            <div class="text-[10px] font-medium text-gray-500 dark:text-gray-400">@log.User.Email</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2 text-gray-400 dark:text-gray-500 italic">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <span class="text-xs font-bold uppercase tracking-wider">System</span>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-5">
                                <div class="text-sm text-gray-600 dark:text-gray-400 max-w-md line-clamp-2">
                                    @log.Description
                                </div>
                            </td>
                            <td class="px-6 py-5 whitespace-nowrap text-right">
                                <span class="text-[10px] font-bold font-mono text-gray-400 dark:text-gray-500 bg-gray-50 dark:bg-gray-900/40 px-2 py-1 rounded-lg">
                                    @log.IpAddress
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 bg-gray-50/50 dark:bg-gray-900/20 border-t border-gray-50 dark:border-gray-700">
            <partial name="Shared/Partials/_Pagination" model="Model.Logs" />
        </div>
    </div>
</div>