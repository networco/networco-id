@page
@model NetworcoId.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "System Settings";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="md:grid md:grid-cols-3 md:gap-6">
        <div class="md:col-span-1">
            <div class="px-4 sm:px-0">
                <h3 class="text-lg font-medium leading-6 text-gray-900">Security Policies</h3>
                <p class="mt-1 text-sm text-gray-600">
                    Configure password complexity requirements and account lockout policies for all users.
                </p>
                
                @if (TempData["StatusMessage"] != null)
                {
                    <div class="mt-4 p-4 rounded-md bg-green-50 border border-green-200">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800">@TempData["StatusMessage"]</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <div class="mt-5 md:mt-0 md:col-span-2">
            <form method="post">
                <div class="shadow sm:rounded-md sm:overflow-hidden">
                    <div class="px-4 py-5 bg-white space-y-6 sm:p-6">
                        <div class="grid grid-cols-6 gap-6">
                            <div class="col-span-6 sm:col-span-3">
                                <label asp-for="Input.MinPasswordLength" class="block text-sm font-medium text-gray-700"></label>
                                <input asp-for="Input.MinPasswordLength" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                <span asp-validation-for="Input.MinPasswordLength" class="text-red-500 text-xs"></span>
                            </div>

                            <div class="col-span-6 sm:col-span-3">
                                <label asp-for="Input.MaxFailedLoginAttempts" class="block text-sm font-medium text-gray-700"></label>
                                <input asp-for="Input.MaxFailedLoginAttempts" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                <span asp-validation-for="Input.MaxFailedLoginAttempts" class="text-red-500 text-xs"></span>
                            </div>

                             <div class="col-span-6 sm:col-span-3">
                                 <label asp-for="Input.LockoutDurationMinutes" class="block text-sm font-medium text-gray-700"></label>
                                 <input asp-for="Input.LockoutDurationMinutes" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                 <span asp-validation-for="Input.LockoutDurationMinutes" class="text-red-500 text-xs"></span>
                             </div>

                             <div class="col-span-6 sm:col-span-3">
                                 <label asp-for="Input.AccessTokenExpirationMinutes" class="block text-sm font-medium text-gray-700"></label>
                                 <input asp-for="Input.AccessTokenExpirationMinutes" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                 <span asp-validation-for="Input.AccessTokenExpirationMinutes" class="text-red-500 text-xs"></span>
                             </div>

                             <div class="col-span-6 sm:col-span-3">
                                 <label asp-for="Input.RefreshTokenExpirationDays" class="block text-sm font-medium text-gray-700"></label>
                                 <input asp-for="Input.RefreshTokenExpirationDays" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                 <span asp-validation-for="Input.RefreshTokenExpirationDays" class="text-red-500 text-xs"></span>
                             </div>
                        </div>


                        <fieldset>
                            <legend class="text-base font-medium text-gray-900">Complexity Requirements</legend>
                            <div class="mt-4 space-y-4">
                                <div class="flex items-start">
                                    <div class="flex items-center h-5">
                                        <input asp-for="Input.RequireDigit" type="checkbox" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                                    </div>
                                    <div class="ml-3 text-sm">
                                        <label asp-for="Input.RequireDigit" class="font-medium text-gray-700">Require Numbers</label>
                                        <p class="text-gray-500">Passwords must contain at least one digit (0-9).</p>
                                    </div>
                                </div>
                                <div class="flex items-start">
                                    <div class="flex items-center h-5">
                                        <input asp-for="Input.RequireUppercase" type="checkbox" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                                    </div>
                                    <div class="ml-3 text-sm">
                                        <label asp-for="Input.RequireUppercase" class="font-medium text-gray-700">Require Uppercase</label>
                                        <p class="text-gray-500">Passwords must contain at least one uppercase letter (A-Z).</p>
                                    </div>
                                </div>
                                <div class="flex items-start">
                                    <div class="flex items-center h-5">
                                        <input asp-for="Input.RequireLowercase" type="checkbox" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                                    </div>
                                    <div class="ml-3 text-sm">
                                        <label asp-for="Input.RequireLowercase" class="font-medium text-gray-700">Require Lowercase</label>
                                        <p class="text-gray-500">Passwords must contain at least one lowercase letter (a-z).</p>
                                    </div>
                                </div>
                                <div class="flex items-start">
                                    <div class="flex items-center h-5">
                                        <input asp-for="Input.RequireNonAlphanumeric" type="checkbox" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                                    </div>
                                    <div class="ml-3 text-sm">
                                        <label asp-for="Input.RequireNonAlphanumeric" class="font-medium text-gray-700">Require Special Characters</label>
                                        <p class="text-gray-500">Passwords must contain at least one special character (e.g., !, $, #, %).</p>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
                        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                            Save Configuration
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}