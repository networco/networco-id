@page "/admin/callback"
@model NetworcoId.Pages.Admin.CallbackModel
@{
    ViewData["Title"] = "Logging in...";
}

<div class="min-h-screen flex items-center justify-center">
    <div class="text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent mb-4"></div>
        <h2 class="text-xl font-semibold text-gray-900">Verifying your session...</h2>
        <p class="text-gray-500 mt-2">Please wait while we complete your login.</p>
    </div>
</div>
