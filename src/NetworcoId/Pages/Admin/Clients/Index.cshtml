@page
@model NetworcoId.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "OAuth Clients";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">OAuth Clients</h1>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Manage applications allowed to authenticate using your identity provider.
            </p>
        </div>
        <div class="flex-shrink-0">
            <a asp-page="./Create" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-indigo-600 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200">
                <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                New Client
            </a>
        </div>
    </div>

    <!-- Search and Filters Card -->
    <div class="mb-8 p-6 rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm">
        <form method="get" class="relative max-w-2xl">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" 
                   placeholder="Search by client name or ID..." 
                   class="block w-full pl-11 pr-4 py-2.5 rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortDescending" value="@Model.SortDescending.ToString().ToLower()" />
        </form>
    </div>

    <!-- Clients Table Card -->
    <div class="overflow-hidden rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200/50 dark:divide-gray-700/50">
                <thead>
                    <tr class="bg-gray-50/50 dark:bg-gray-900/50">
                        <th scope="col" class="py-4 pl-6 pr-3 text-left">
                            <a asp-page="./Index" asp-route-SortBy="DisplayName" asp-route-SortDescending="@(Model.SortBy == "DisplayName" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm" 
                               class="group flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Client
                                <span class="flex-none rounded bg-gray-100 dark:bg-gray-800 text-gray-400 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-900/30 group-hover:text-indigo-600 transition-colors">
                                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "DisplayName" ? (Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7") : "M7 10l5 5 5-5")" />
                                    </svg>
                                </span>
                            </a>
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Redirect URIs</th>
                        <th scope="col" class="px-3 py-4 text-center">
                            <a asp-page="./Index" asp-route-SortBy="IsActive" asp-route-SortDescending="@(Model.SortBy == "IsActive" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm"
                               class="group flex items-center justify-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Status
                                <span class="flex-none rounded bg-gray-100 dark:bg-gray-800 text-gray-400 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-900/30 group-hover:text-indigo-600 transition-colors">
                                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "IsActive" ? (Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7") : "M7 10l5 5 5-5")" />
                                    </svg>
                                </span>
                            </a>
                        </th>
                        <th scope="col" class="relative py-4 pl-3 pr-6 text-right">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
                    @foreach (var client in Model.Clients.Items)
                    {
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-900/30 transition-colors duration-150 group">
                            <td class="whitespace-nowrap py-5 pl-6 pr-3">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0">
                                        <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold shadow-sm ring-2 ring-white dark:ring-gray-800">
                                            @client.DisplayName[0].ToString().ToUpper()
                                        </div>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                            <a asp-page="./Edit" asp-route-id="@client.ClientId">@client.DisplayName</a>
                                        </div>
                                        <div class="text-xs font-mono text-gray-500 dark:text-gray-400">@client.ClientId</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-5">
                                <div class="flex flex-wrap gap-1.5 max-w-xs">
                                    @foreach (var uri in client.RedirectUris.Take(2))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium bg-gray-100 dark:bg-gray-900/50 text-gray-600 dark:text-gray-400 border border-gray-200/50 dark:border-gray-700/50 truncate" title="@uri">
                                            @uri
                                        </span>
                                    }
                                    @if (client.RedirectUris.Count > 2)
                                    {
                                        <span class="text-[10px] text-gray-400 dark:text-gray-500">+@(client.RedirectUris.Count - 2) more</span>
                                    }
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-5 text-center">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset 
                                    @(client.IsActive ? "bg-green-500/10 text-green-700 dark:text-green-400 ring-green-600/20" : "bg-red-500/10 text-red-700 dark:text-red-400 ring-red-600/20")">
                                    <span class="h-1.5 w-1.5 rounded-full @(client.IsActive ? "bg-green-600 dark:bg-green-400" : "bg-red-600 dark:bg-red-400")"></span>
                                    @(client.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="relative whitespace-nowrap py-5 pl-3 pr-6 text-right text-sm font-medium">
                                <div class="flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a asp-page="./Edit" asp-route-id="@client.ClientId" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300 transition-colors">Edit</a>
                                    
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@client.ClientId">
                                        <button type="submit" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">
                                            @(client.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@client.ClientId" onsubmit="return confirm('Are you sure you want to delete this client?')">
                                        <button type="submit" class="text-red-600 dark:text-red-400 hover:text-red-900 dark:hover:text-red-300 transition-colors">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="px-6 py-4 bg-gray-50/30 dark:bg-gray-900/30 border-t border-gray-200/50 dark:border-gray-700/50">
            <partial name="Shared/Partials/_Pagination" model="Model.Clients" />
        </div>
    </div>
</div>
