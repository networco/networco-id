@page
@model NetworcoId.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "OAuth Clients";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">OAuth Clients</h1>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Manage applications allowed to authenticate using your identity provider.
            </p>
        </div>
        <div class="flex-shrink-0">
            <a asp-page="./Create" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 text-sm font-bold text-white shadow-lg shadow-indigo-200 dark:shadow-none hover:bg-indigo-700 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                New Client
            </a>
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="mb-8 p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
        <form method="get" class="relative max-w-2xl">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" 
                   placeholder="Search by client name or ID..." 
                   class="block w-full pl-11 pr-4 py-3 rounded-xl border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-indigo-500 transition-all duration-200 sm:text-sm" />
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortDescending" value="@Model.SortDescending.ToString().ToLower()" />
        </form>
    </div>

    <!-- Clients Table Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
                <thead>
                    <tr class="bg-gray-50/50 dark:bg-gray-900/20">
                        <th scope="col" class="py-4 pl-6 pr-3 text-left">
                            <a asp-page="./Index" asp-route-SortBy="DisplayName" asp-route-SortDescending="@(Model.SortBy == "DisplayName" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm" 
                               class="group flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Client
                                <svg class="h-3 w-3 @(Model.SortBy == "DisplayName" ? "text-indigo-600" : "text-gray-300 opacity-0 group-hover:opacity-100")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "DisplayName" && Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7")" />
                                </svg>
                            </a>
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Redirect URIs</th>
                        <th scope="col" class="px-3 py-4 text-center">
                            <a asp-page="./Index" asp-route-SortBy="IsActive" asp-route-SortDescending="@(Model.SortBy == "IsActive" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm"
                               class="group flex items-center justify-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Status
                                <svg class="h-3 w-3 @(Model.SortBy == "IsActive" ? "text-indigo-600" : "text-gray-300 opacity-0 group-hover:opacity-100")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "IsActive" && Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7")" />
                                </svg>
                            </a>
                        </th>
                        <th scope="col" class="relative py-4 pl-3 pr-6 text-right">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var client in Model.Clients.Items)
                    {
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-900/40 transition-colors duration-150 group">
                            <td class="whitespace-nowrap py-5 pl-6 pr-3">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0">
                                        <div class="h-10 w-10 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-extrabold shadow-sm group-hover:scale-110 transition-transform">
                                            @client.DisplayName[0].ToString().ToUpper()
                                        </div>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                            <a asp-page="./Edit" asp-route-id="@client.ClientId">@client.DisplayName</a>
                                        </div>
                                        <div class="text-[10px] font-bold font-mono text-gray-400 dark:text-gray-500 uppercase tracking-widest">@client.ClientId</div>
                                        <div class="mt-1 text-[10px] font-medium text-gray-400 dark:text-gray-500 truncate max-w-[200px]" title="Audience: @client.Audience">
                                            <span class="uppercase tracking-tighter text-[9px] opacity-70">Aud:</span> @client.Audience
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-5">
                                <div class="flex flex-wrap gap-1.5 max-w-xs">
                                    @foreach (var uri in client.RedirectUris.Take(2))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-gray-50 dark:bg-gray-900/40 text-gray-500 dark:text-gray-400 border border-gray-100 dark:border-gray-700 truncate" title="@uri">
                                            @uri
                                        </span>
                                    }
                                    @if (client.RedirectUris.Count > 2)
                                    {
                                        <span class="text-[10px] font-bold text-gray-400 dark:text-gray-500">+@(client.RedirectUris.Count - 2)</span>
                                    }
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-5 text-center">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider
                                    @(client.IsActive ? "bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 border border-green-100 dark:border-green-800/30" : "bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 border border-red-100 dark:border-red-800/30")">
                                    <span class="h-1.5 w-1.5 rounded-full @(client.IsActive ? "bg-green-600" : "bg-red-600")"></span>
                                    @(client.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                             <td class="relative whitespace-nowrap py-5 pl-3 pr-6 text-right">
                                <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-200">
                                    @if (client.ClientId == Model.SystemClientId)
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-indigo-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-700 dark:bg-indigo-900/20 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-800/30">System</span>
                                    }

                                    <a asp-page="./Edit" asp-route-id="@client.ClientId" class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 hover:text-indigo-700">Edit</a>
                                    
                                    @if (client.ClientId != Model.SystemClientId)
                                    {
                                        <form method="post" asp-page-handler="Toggle" asp-route-id="@client.ClientId" class="flex">
                                            <button type="submit" class="text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
                                                @(client.IsActive ? "Disable" : "Enable")
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Delete" asp-route-id="@client.ClientId" onsubmit="return confirm('Are you sure you want to delete this client?')" class="flex">
                                            <button type="submit" class="text-xs font-bold uppercase tracking-widest text-red-600 hover:text-red-900">Delete</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="px-6 py-4 bg-gray-50/50 dark:bg-gray-900/20 border-t border-gray-50 dark:border-gray-700">
            <partial name="Shared/Partials/_Pagination" model="Model.Clients" />
        </div>
    </div>
</div>
