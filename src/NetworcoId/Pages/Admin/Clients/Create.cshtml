@page
@model NetworcoId.Pages.Admin.Clients.CreateModel
@{
    ViewData["Title"] = "Create Client";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-4">
            <li>
                <div>
                    <a asp-page="./Index" class="text-gray-400 hover:text-gray-500 transition-colors">
                        <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                        </svg>
                        <span class="sr-only">Clients</span>
                    </a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="h-5 w-5 flex-shrink-0 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="ml-4 text-sm font-medium text-gray-500 dark:text-gray-400">New Client</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">Create OAuth Client</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Register a new application to enable OIDC/OAuth 2.0 flows.</p>
    </div>

    @if (Model.CreatedSecret != null)
    {
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden animate-in zoom-in-95 duration-500">
            <div class="p-8">
                <div class="flex items-center gap-4 mb-6">
                    <div class="h-12 w-12 rounded-full bg-green-500/10 flex items-center justify-center text-green-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Client Created Successfully</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Store these credentials securely. The secret will not be shown again.</p>
                    </div>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2">Client ID</label>
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-950/50 border border-gray-200/50 dark:border-gray-800/50 font-mono text-sm text-gray-900 dark:text-gray-300 select-all">
                            @Model.CreatedClientId
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2">Client Secret</label>
                        <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-950/50 border border-gray-200/50 dark:border-gray-800/50 font-mono text-sm text-gray-900 dark:text-gray-300 break-all select-all">
                            @Model.CreatedSecret
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-8 border-t border-gray-200/50 dark:border-gray-700/50 flex justify-end">
                    <a asp-page="./Index" class="px-6 py-2.5 rounded-xl bg-indigo-600 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-all">
                        Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <form method="post" class="space-y-8">
            <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
                <div class="p-6 space-y-6">
                    <div>
                        <label asp-for="DisplayName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Display Name</label>
                        <input asp-for="DisplayName" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" required placeholder="e.g. Internal Portal" />
                    </div>

                    <div>
                        <label asp-for="RedirectUris" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Redirect URIs (one per line)</label>
                        <textarea asp-for="RedirectUris" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200 font-mono text-sm h-32" required placeholder="https://app.example.com/callback"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-4">Allowed Scopes</label>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 p-4 rounded-xl border border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                            @foreach (var scope in Model.AvailableScopes)
                            {
                                <label class="relative flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer group">
                                    <input type="checkbox" name="SelectedScopes" value="@scope" @(Model.SelectedScopes.Contains(scope) ? "checked" : "")
                                           class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 transition-colors" />
                                    <span class="text-xs font-mono text-gray-600 dark:text-gray-400 group-hover:text-indigo-600 transition-colors">@scope</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/20 bg-indigo-500/5">
                        <div class="flex items-center">
                            <div class="h-10 w-10 rounded-lg bg-indigo-500/20 flex items-center justify-center text-indigo-600">
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-semibold text-gray-900 dark:text-white">Trusted for Exchange</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">Allow this client to perform BFF code exchanges.</p>
                            </div>
                        </div>
                        <div class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                            <input type="checkbox" asp-for="IsTrustedForExchange" class="peer sr-only" />
                            <div class="peer-checked:bg-indigo-600 bg-gray-200 dark:bg-gray-700 absolute inset-0 rounded-full transition-colors duration-200"></div>
                            <div class="peer-checked:translate-x-5 translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-4 pt-4">
                <a asp-page="./Index" class="px-6 py-2.5 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Cancel</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200">
                    Create Client
                </button>
            </div>
        </form>
    }
</div>
