@page
@model NetworcoId.Pages.Admin.Clients.CreateModel
@{
    ViewData["Title"] = "Create Client";
}

<div class="container mx-auto px-4 py-12 max-w-3xl">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Create OAuth Client</h1>
        <a href="/Admin/Clients/Index" class="text-gray-600 hover:text-indigo-600 font-medium transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to List
        </a>
    </div>

    <div class="bg-white/80 backdrop-blur-xl shadow-xl rounded-2xl overflow-hidden border border-white/50">
        <div class="p-8">
            @if (Model.CreatedSecret != null)
            {
                <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-8 shadow-sm">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center text-green-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div class="w-full">
                            <h3 class="text-lg font-bold text-green-900 mb-2">Client Created Successfully!</h3>
                            <p class="text-green-800 mb-4">
                                Please copy the credentials now. You won't be able to see the secret again.
                            </p>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-xs font-bold text-green-700 uppercase tracking-wider mb-1">Client ID</label>
                                    <div class="bg-white p-3 rounded-lg border border-green-200 font-mono text-sm select-all shadow-inner text-gray-700">
                                        @Model.CreatedClientId
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-green-700 uppercase tracking-wider mb-1">Client Secret</label>
                                    <div class="bg-white p-3 rounded-lg border border-green-200 font-mono text-sm break-all select-all shadow-inner text-gray-700">
                                        @Model.CreatedSecret
                                    </div>
                                </div>
                            </div>

                            <div class="mt-8">
                                <a href="/Admin/Clients/Index" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-green-700 bg-green-100 hover:bg-green-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                                    Return to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <form method="post" class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2" asp-for="DisplayName">
                            Display Name
                        </label>
                        <input class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none"
                               asp-for="DisplayName" required placeholder="e.g. NETWORCO Web App">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2" asp-for="RedirectUris">
                            Redirect URIs (one per line)
                        </label>
                        <textarea class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none h-32 font-mono text-sm"
                                  asp-for="RedirectUris" required placeholder="http://localhost:3000/auth/callback"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2" asp-for="Scopes">
                            Allowed Scopes (comma separated)
                        </label>
                        <input class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none"
                               asp-for="Scopes">
                    </div>

                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input asp-for="IsTrustedForExchange" type="checkbox" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                        </div>
                        <div class="ml-3 text-sm">
                            <label asp-for="IsTrustedForExchange" class="font-medium text-gray-700">Trusted for Exchange</label>
                            <p class="text-gray-500">Allow this client to exchange codes for other clients (BFF pattern).</p>
                        </div>
                    </div>

                    <div class="pt-4 flex items-center justify-end gap-4">
                        <a href="/Admin/Clients/Index" class="text-gray-600 hover:text-gray-900 font-medium px-4 py-2 rounded-lg hover:bg-gray-100 transition-colors">Cancel</a>
                        <button class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-indigo-200 transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                                type="submit">
                            Create Client
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
}
        </div>
    </div>
</div>
