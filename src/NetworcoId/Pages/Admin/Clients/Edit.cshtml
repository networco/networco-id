@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('scope-tags-container');
            const input = document.getElementById('scope-input');
            const hidden = document.getElementById('scopes-hidden');
            
            // For edit page, we need to filter out the "AvailableScopes" from the initial tags 
            // because they are handled by checkboxes
            const availableScopes = [@Html.Raw(string.Join(",", ((List<string>)Model.AvailableScopes).Select(s => $"\"{s}\"")))];
            let tags = hidden.value ? hidden.value.split(',').map(s => s.trim()).filter(s => s && !availableScopes.includes(s)) : [];

            function updateTags() {
                container.querySelectorAll('.scope-tag').forEach(t => t.remove());
                tags.forEach(tag => {
                    const pill = document.createElement('span');
                    pill.className = 'scope-tag inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-xs font-mono group cursor-pointer hover:bg-amber-500/20 transition-all';
                    pill.innerHTML = `${tag}<svg class="w-3 h-3 text-amber-400 group-hover:text-amber-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                    pill.onclick = () => removeTag(tag);
                    container.insertBefore(pill, input);
                });
                hidden.value = tags.join(',');
            }

            function addTag(tag) {
                tag = tag.trim().toLowerCase().replace(/[^a-z0-9._-]/g, '');
                if (tag && !tags.includes(tag) && !availableScopes.includes(tag)) {
                    tags.push(tag);
                    updateTags();
                }
                input.value = '';
            }

            function removeTag(tag) {
                tags = tags.filter(t => t !== tag);
                updateTags();
            }

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    addTag(input.value);
                } else if (e.key === 'Backspace' && !input.value && tags.length > 0) {
                    removeTag(tags[tags.length - 1]);
                }
            });

            input.addEventListener('blur', () => {
                if (input.value) addTag(input.value);
            });

            updateTags();
        });
    </script>
}