@page
@model NetworcoId.Pages.Admin.Clients.EditModel
@{
    ViewData["Title"] = "Edit Client";
    Layout = "_Layout";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-4">
            <li>
                <div>
                    <a asp-page="./Index" class="text-gray-400 hover:text-gray-500 transition-colors">
                        <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                        </svg>
                        <span class="sr-only">Clients</span>
                    </a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="h-5 w-5 flex-shrink-0 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="ml-4 text-sm font-medium text-gray-500 dark:text-gray-400">Edit Client</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="min-w-0 flex-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">@Model.DisplayName</h1>
            <div class="mt-2 flex items-center gap-4">
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200/50 dark:border-gray-700/50">@Model.ClientId</span>
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset 
                    @(Model.IsActive ? "bg-green-500/10 text-green-700 dark:text-green-400 ring-green-600/20" : "bg-red-500/10 text-red-700 dark:text-red-400 ring-red-600/20")">
                    <span class="h-1.5 w-1.5 rounded-full @(Model.IsActive ? "bg-green-600 dark:bg-green-400" : "bg-red-600 dark:bg-red-400")"></span>
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>
        </div>
    </div>

    @if (Model.NewSecret != null)
    {
        <div class="mb-8 p-6 rounded-2xl bg-green-50/50 dark:bg-green-900/10 border border-green-200/50 dark:border-green-800/30 backdrop-blur-xl animate-in fade-in slide-in-from-top-4 duration-500">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-green-100 dark:bg-green-900/40 rounded-full flex items-center justify-center text-green-600 dark:text-green-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-bold text-green-900 dark:text-green-300 mb-1">New @Model.SecretType Secret Generated</h3>
                    <p class="text-sm text-green-800 dark:text-green-400/80 mb-4">
                        Copy this secret now. It will not be displayed again.
                    </p>
                    <div class="group relative">
                        <div class="bg-white/50 dark:bg-gray-950/50 p-4 rounded-xl border border-green-200 dark:border-green-800/50 font-mono text-sm break-all select-all shadow-inner text-gray-700 dark:text-gray-300">
                            @Model.NewSecret
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <form method="post" class="space-y-8">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ClientId" />

        <!-- Section: General Information -->
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Configuration</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">OIDC and OAuth 2.0 client identification and endpoints.</p>
            </div>
            <div class="p-6 space-y-6">
                <div>
                    <label asp-for="DisplayName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Display Name</label>
                    <input asp-for="DisplayName" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" required />
                </div>

                <div>
                    <label asp-for="RedirectUris" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Redirect URIs (one per line)</label>
                    <textarea asp-for="RedirectUris" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200 font-mono text-sm h-32" required></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-4">Allowed Scopes</label>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 p-4 rounded-xl border border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                        @foreach (var scope in Model.AvailableScopes)
                        {
                            <label class="relative flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer group">
                                <input type="checkbox" name="SelectedScopes" value="@scope" @(Model.SelectedScopes.Contains(scope) ? "checked" : "")
                                       class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 transition-colors" />
                                <span class="text-xs font-mono text-gray-600 dark:text-gray-400 group-hover:text-indigo-600 transition-colors">@scope</span>
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <label asp-for="Scopes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Additional Custom Scopes (comma separated)</label>
                    <input asp-for="Scopes" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200 font-mono text-sm" placeholder="e.g. legacy.api, reports.read" />
                </div>

                <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/20 bg-indigo-500/5">
                    <div class="flex items-center">
                        <div class="h-10 w-10 rounded-lg bg-indigo-500/20 flex items-center justify-center text-indigo-600">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-semibold text-gray-900 dark:text-white">Trusted for Exchange (BFF/API)</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Allows client to exchange codes for other clients (BFF pattern).</p>
                        </div>
                    </div>
                    <div class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                        <input type="checkbox" asp-for="IsTrustedForExchange" class="peer sr-only" />
                        <div class="peer-checked:bg-indigo-600 bg-gray-200 dark:bg-gray-700 absolute inset-0 rounded-full transition-colors duration-200"></div>
                        <div class="peer-checked:translate-x-5 translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Secrets -->
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Security Secrets</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage client credentials for authenticated flows.</p>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-center justify-between p-4 rounded-xl border border-gray-200/50 bg-white/50 dark:bg-gray-900/50">
                    <div>
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">Primary Secret</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Active credential for system authentication.</p>
                    </div>
                    <button type="submit" asp-page-handler="RotatePrimary" asp-route-id="@Model.ClientId" class="px-4 py-2 text-xs font-bold text-indigo-600 dark:text-indigo-400 border border-indigo-600/30 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-colors" onclick="return confirm('Immediately invalidate current primary secret?')">
                        Rotate Primary
                    </button>
                </div>

                <div class="flex items-center justify-between p-4 rounded-xl border border-gray-200/50 bg-white/50 dark:bg-gray-900/50">
                    <div>
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">Secondary Secret</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">@(Model.HasSecondarySecret ? "Active. Useful for rolling rotations." : "Not configured.")</p>
                    </div>
                    <div class="flex gap-2">
                        @if (Model.HasSecondarySecret)
                        {
                            <button type="submit" asp-page-handler="ClearSecondary" asp-route-id="@Model.ClientId" class="px-4 py-2 text-xs font-bold text-red-600 border border-red-600/30 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors">
                                Remove
                            </button>
                        }
                        <button type="submit" asp-page-handler="RotateSecondary" asp-route-id="@Model.ClientId" class="px-4 py-2 text-xs font-bold text-gray-600 dark:text-gray-400 border border-gray-600/30 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-950/30 transition-colors">
                            @(Model.HasSecondarySecret ? "Rotate Secondary" : "Generate Secondary")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-4 pt-4">
            <a asp-page="./Index" class="px-6 py-2.5 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Cancel</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200">
                Save Changes
            </button>
        </div>
    </form>
</div>
