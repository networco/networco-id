@page "{id:guid}"
@model NetworcoId.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
    var isLocked = Model.UserData.Credential?.LockedUntil > DateTimeOffset.UtcNow;
    var isAdmin = Model.UserData.Roles?.Contains("admin") == true;
    var isOnlyAdmin = Model.UserData.IsActive && isAdmin && Model.ActiveAdminCount <= 1;
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-4">
            <li>
                <div>
                    <a asp-page="./Index" class="text-gray-400 hover:text-gray-500 transition-colors">
                        <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                        </svg>
                        <span class="sr-only">Users</span>
                    </a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="h-5 w-5 flex-shrink-0 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="ml-4 text-sm font-medium text-gray-500 dark:text-gray-400">Edit User</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="min-w-0 flex-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">@Model.UserData.FirstName @Model.UserData.LastName</h1>
            <div class="mt-2 flex items-center gap-4">
                <span class="text-sm text-gray-500 dark:text-gray-400">@Model.UserData.Email</span>
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset 
                    @(Model.UserData.IsActive ? "bg-green-500/10 text-green-700 dark:text-green-400 ring-green-600/20" : "bg-red-500/10 text-red-700 dark:text-red-400 ring-red-600/20")">
                    <span class="h-1.5 w-1.5 rounded-full @(Model.UserData.IsActive ? "bg-green-600 dark:bg-green-400" : "bg-red-600 dark:bg-red-400")"></span>
                    @(Model.UserData.IsActive ? "Active" : "Inactive")
                </span>
            </div>
        </div>
    </div>

    <form method="post" class="space-y-8">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserData.Id" />
        <div asp-validation-summary="All" class="rounded-xl bg-red-50/50 dark:bg-red-900/10 p-4 border border-red-200/50 dark:border-red-800/30 text-sm text-red-600 dark:text-red-400 backdrop-blur-sm"></div>

        <!-- Section: Profile Information -->
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Profile Details</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Standard OIDC claims and contact information.</p>
            </div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="UserData.FirstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">First Name</label>
                    <input asp-for="UserData.FirstName" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                </div>
                <div>
                    <label asp-for="UserData.LastName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Last Name</label>
                    <input asp-for="UserData.LastName" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                </div>
                <div>
                    <label asp-for="UserData.Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                    <input asp-for="UserData.Email" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                </div>
                <div>
                    <label asp-for="UserData.PhoneNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Phone Number</label>
                    <input asp-for="UserData.PhoneNumber" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="UserData.NationalId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">National ID</label>
                    <input asp-for="UserData.NationalId" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200 font-mono" />
                </div>
            </div>
        </div>

        <!-- Section: Address Information -->
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Address</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">OIDC address claims used for identity verification.</p>
            </div>
            <div class="p-6 space-y-6">
                <div>
                    <label asp-for="UserData.AddressStreetAddress" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Street Address</label>
                    <input asp-for="UserData.AddressStreetAddress" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="UserData.AddressPostalCode" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Postal Code</label>
                        <input asp-for="UserData.AddressPostalCode" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="UserData.AddressLocality" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Locality (City)</label>
                        <input asp-for="UserData.AddressLocality" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="UserData.AddressCountry" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Country</label>
                        <input asp-for="UserData.AddressCountry" class="block w-full rounded-xl border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Account & Security -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Security & Status -->
            <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Security & Access</h3>
                </div>
                <div class="p-6 space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">Active Account</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Deactivated users cannot log in.</p>
                        </div>
                        <div class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                            @if (isOnlyAdmin)
                            {
                                <input type="checkbox" asp-for="UserData.IsActive" class="peer sr-only" disabled />
                            }
                            else
                            {
                                <input type="checkbox" asp-for="UserData.IsActive" class="peer sr-only" />
                            }
                            <div class="peer-checked:bg-indigo-600 bg-gray-200 dark:bg-gray-700 absolute inset-0 rounded-full transition-colors duration-200"></div>
                            <div class="peer-checked:translate-x-5 translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-gray-200/50 dark:border-gray-700/50">
                        <p class="text-sm font-medium text-gray-900 dark:text-white mb-4">Brute Force Protection</p>
                        @if (isLocked)
                        {
                            <div class="rounded-xl bg-yellow-500/10 p-4 border border-yellow-600/20">
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    <span class="ml-3 text-sm text-yellow-700 dark:text-yellow-400">Account locked until @Model.UserData.Credential!.LockedUntil!.Value.LocalDateTime.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <button type="submit" asp-page-handler="Unlock" class="mt-4 w-full text-center px-4 py-2 text-sm font-semibold text-yellow-700 hover:bg-yellow-100 rounded-lg transition-colors border border-yellow-600/30">
                                    Unlock Now
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                Account is secure and accessible.
                            </div>
                        }
                    </div>
                </div>
            </div>

        <!-- Section: Roles -->
        <div class="rounded-2xl bg-white/70 dark:bg-gray-800/50 border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-xl shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Roles & Permissions</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage user access levels and system roles.</p>
            </div>
            <div class="p-6 space-y-6">
                <!-- Standard Roles Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4 rounded-xl border border-gray-200/50 dark:border-gray-700/50 bg-gray-50/30 dark:bg-gray-900/30">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var isRoleOnlyAdmin = role == "admin" && isOnlyAdmin;
                        <label class="relative flex items-center justify-between p-3 rounded-lg hover:bg-white/50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer group">
                            <div class="flex items-center gap-3">
                                <div class="h-8 w-8 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-600">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="text-sm font-semibold text-gray-900 dark:text-white">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(role.Replace("_", " "))</span>
                                </div>
                            </div>
                            <div class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none">
                                <input type="checkbox" name="SelectedRoles" value="@role" @(Model.SelectedRoles.Contains(role) ? "checked" : "") @(isRoleOnlyAdmin ? "disabled" : "") class="peer sr-only" />
                                <div class="peer-checked:bg-indigo-600 bg-gray-200 dark:bg-gray-700 absolute inset-0 rounded-full transition-colors duration-200"></div>
                                <div class="peer-checked:translate-x-5 translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></div>
                                @if (isRoleOnlyAdmin) { <input type="hidden" name="SelectedRoles" value="admin" /> }
                            </div>
                        </label>
                    }
                </div>

                <!-- Tag-based Custom Roles -->
                <div class="space-y-2">
                    <label asp-for="Roles" class="block text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Custom Roles</label>
                    <div id="role-tags-container" class="min-h-[46px] p-2 rounded-xl border border-gray-200/60 dark:border-gray-700/60 bg-white/50 dark:bg-gray-900/50 flex flex-wrap gap-2 focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 transition-all duration-200">
                        <input type="text" id="role-input" 
                               class="flex-1 min-w-[120px] bg-transparent border-none focus:ring-0 text-sm font-mono text-gray-900 dark:text-white p-1" 
                               placeholder="Type role and press Enter..." />
                    </div>
                    <input type="hidden" asp-for="Roles" id="roles-hidden" />
                    <p class="text-[10px] text-gray-400 dark:text-gray-500 italic">Press Enter or comma to add a custom role. Click a tag to remove it.</p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-4 pt-4">
            <a asp-page="./Index" class="px-6 py-2.5 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Cancel</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('role-tags-container');
            const input = document.getElementById('role-input');
            const hidden = document.getElementById('roles-hidden');
            
            const availableRoles = [@Html.Raw(string.Join(",", Model.AvailableRoles.Select(s => $"\"{s}\"")))];
            let tags = hidden.value ? hidden.value.split(',').map(s => s.trim()).filter(s => s && !availableRoles.includes(s)) : [];

            function updateTags() {
                container.querySelectorAll('.role-tag').forEach(t => t.remove());
                tags.forEach(tag => {
                    const pill = document.createElement('span');
                    pill.className = 'role-tag inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-xs font-mono group cursor-pointer hover:bg-amber-500/20 transition-all';
                    pill.innerHTML = `${tag}<svg class="w-3 h-3 text-amber-400 group-hover:text-amber-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                    pill.onclick = () => removeTag(tag);
                    container.insertBefore(pill, input);
                });
                hidden.value = tags.join(',');
            }

            function addTag(tag) {
                tag = tag.trim().toLowerCase().replace(/[^a-z0-9._-]/g, '');
                if (tag && !tags.includes(tag) && !availableRoles.includes(tag)) {
                    tags.push(tag);
                    updateTags();
                }
                input.value = '';
            }

            function removeTag(tag) {
                tags = tags.filter(t => t !== tag);
                updateTags();
            }

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    addTag(input.value);
                } else if (e.key === 'Backspace' && !input.value && tags.length > 0) {
                    removeTag(tags[tags.length - 1]);
                }
            });

            input.addEventListener('blur', () => {
                if (input.value) addTag(input.value);
            });

            updateTags();
        });
    </script>
}
