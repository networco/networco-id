@page
@model NetworcoId.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Users</h1>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Manage your user accounts, status, and security settings from a centralized dashboard.
            </p>
        </div>
        <div class="flex-shrink-0">
            <a asp-page="./Create" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 text-sm font-bold text-white shadow-lg shadow-indigo-200 dark:shadow-none hover:bg-indigo-700 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Create User
            </a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 flex items-center gap-3 animate-in fade-in slide-in-from-top-2 duration-300">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
            </div>
            <p class="text-sm font-medium text-green-800 dark:text-green-300">@TempData["StatusMessage"]</p>
        </div>
    }

    <!-- Search and Filters -->
    <div class="mb-8 p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm">
        <form method="get" class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" 
                   placeholder="Search by name, email, or national ID..." 
                   class="block w-full pl-11 pr-4 py-3 rounded-xl border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-indigo-500 transition-all duration-200 sm:text-sm" />
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortDescending" value="@Model.SortDescending.ToString().ToLower()" />
        </form>
    </div>

    <!-- Users Table Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
                <thead>
                    <tr class="bg-gray-50/50 dark:bg-gray-900/20">
                        <th scope="col" class="py-4 pl-6 pr-3 text-left">
                            <a asp-page="./Index" asp-route-SortBy="Email" asp-route-SortDescending="@(Model.SortBy == "Email" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm" 
                               class="group flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                User
                                <svg class="h-3 w-3 @(Model.SortBy == "Email" ? "text-indigo-600" : "text-gray-300 opacity-0 group-hover:opacity-100")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "Email" && Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7")" />
                                </svg>
                            </a>
                        </th>
                        <th scope="col" class="px-3 py-4 text-left">
                            <a asp-page="./Index" asp-route-SortBy="IsActive" asp-route-SortDescending="@(Model.SortBy == "IsActive" ? (!Model.SortDescending).ToString().ToLower() : "false")" asp-route-SearchTerm="@Model.SearchTerm"
                               class="group flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Status
                                <svg class="h-3 w-3 @(Model.SortBy == "IsActive" ? "text-indigo-600" : "text-gray-300 opacity-0 group-hover:opacity-100")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Model.SortBy == "IsActive" && Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7")" />
                                </svg>
                            </a>
                        </th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Security</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Roles</th>
                        <th scope="col" class="px-3 py-4 text-left">
                            <a asp-page="./Index" asp-route-SortBy="CreatedAt" asp-route-SortDescending="@(Model.SortBy == "CreatedAt" ? (!Model.SortDescending).ToString().ToLower() : "true")" asp-route-SearchTerm="@Model.SearchTerm"
                               class="group flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                Created
                                <svg class="h-3 w-3 @(Model.SortBy == "CreatedAt" || string.IsNullOrEmpty(Model.SortBy) ? "text-indigo-600" : "text-gray-300 opacity-0 group-hover:opacity-100")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@((Model.SortBy == "CreatedAt" || string.IsNullOrEmpty(Model.SortBy)) && Model.SortDescending ? "M19 9l-7 7-7-7" : "M5 15l7-7 7 7")" />
                                </svg>
                            </a>
                        </th>
                        <th scope="col" class="relative py-4 pl-3 pr-6 text-right">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
                    @foreach (var user in Model.Users.Items)
                    {
                        var isLocked = user.Credential?.LockedUntil > DateTimeOffset.UtcNow;
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-900/40 transition-colors duration-150 group">
                            <td class="whitespace-nowrap py-5 pl-6 pr-3">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0">
                                        <div class="h-10 w-10 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-extrabold shadow-sm group-hover:scale-110 transition-transform">
                                            @user.FirstName[0]@user.LastName[0]
                                        </div>
                                    </div>
                                    <div class="ml-4">
                                         <div class="text-sm font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                            <a asp-page="./Edit" asp-route-id="@user.Id">@user.FirstName @user.LastName</a>
                                        </div>
                                        <div class="text-xs font-medium text-gray-500 dark:text-gray-400">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-5">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider
                                    @(user.IsActive ? "bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 border border-green-100 dark:border-green-800/30" : "bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 border border-red-100 dark:border-red-800/30")">
                                    <span class="h-1.5 w-1.5 rounded-full @(user.IsActive ? "bg-green-600" : "bg-red-600")"></span>
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-3 py-5">
                                @if (isLocked)
                                {
                                    <div class="flex flex-col">
                                        <span class="inline-flex items-center rounded-lg bg-amber-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:bg-amber-900/20 dark:text-amber-400 border border-amber-100 dark:border-amber-800/30">
                                            Locked
                                        </span>
                                        <span class="text-[10px] font-medium text-gray-400 dark:text-gray-500 mt-1">Until @user.Credential!.LockedUntil!.Value.LocalDateTime.ToString("HH:mm")</span>
                                    </div>
                                }
                                else if (user.Credential?.FailedLoginAttempts > 0)
                                {
                                    <span class="inline-flex items-center text-xs font-bold text-orange-600 dark:text-orange-400">
                                        <svg class="mr-1 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                        @user.Credential.FailedLoginAttempts failed
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500">
                                        <svg class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                        Secure
                                    </span>
                                }
                            </td>
                            <td class="whitespace-nowrap px-3 py-5">
                                <div class="flex flex-wrap gap-1.5">
                                    @if (user.Roles?.Contains("admin") == true)
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-indigo-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-700 dark:bg-indigo-900/20 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-800/30">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-gray-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-gray-600 dark:bg-gray-900/40 dark:text-gray-400 border border-gray-100 dark:border-gray-700">User</span>
                                    }
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-5 text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                                @user.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="relative whitespace-nowrap py-5 pl-3 pr-6 text-right">
                                <div class="flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-200">
                                     @if (isLocked || (user.Credential?.FailedLoginAttempts > 0))
                                    {
                                        <form method="post" asp-page-handler="Unlock" asp-route-id="@user.Id">
                                            <button type="submit" class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 hover:text-indigo-700">Unlock</button>
                                        </form>
                                    }
                                    
                                    <a asp-page="./Edit" asp-route-id="@user.Id" class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 hover:text-indigo-700">Edit</a>
                                    
                                    @if (user.Email != "admin@networco.local")
                                    {
                                        var isOnlyAdmin = user.IsActive && user.Roles?.Contains("admin") == true && Model.ActiveAdminCount <= 1;
                                        
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id">
                                            @if (isOnlyAdmin && user.IsActive)
                                            {
                                                <span class="text-gray-400/50 text-[10px] font-bold uppercase tracking-widest italic cursor-not-allowed">Locked</span>
                                            }
                                            else
                                            {
                                                <button type="submit" class="text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
                                                    @(user.IsActive ? "Disable" : "Enable")
                                                </button>
                                            }
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="px-6 py-4 bg-gray-50/50 dark:bg-gray-900/20 border-t border-gray-50 dark:border-gray-700">
            <partial name="Shared/Partials/_Pagination" model="Model.Users" />
        </div>
    </div>
</div>
