@page
@model NetworcoId.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Bytt passord";
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NETWORCO - Bytt passord</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 max-w-md w-full p-10">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-2">Bytt passord</h1>
            <p class="text-gray-500 font-medium">Du må bytte passord før du kan fortsette</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-100 text-red-700 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="RedirectUri" />
            <input type="hidden" asp-for="State" />
            <input type="hidden" asp-for="Scope" />

            <div>
                <label asp-for="CurrentPassword" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Nåværende passord</label>
                <input type="password" asp-for="CurrentPassword" required
                    class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all outline-none text-gray-900 font-medium" />
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Nytt passord</label>
                <input type="password" asp-for="NewPassword" required minlength="@Model.MinPasswordLength"
                    class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all outline-none text-gray-900 font-medium" />
                <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mt-2 px-1">Minst @Model.MinPasswordLength tegn, store/små bokstaver og tall</p>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Bekreft nytt passord</label>
                <input type="password" asp-for="ConfirmPassword" required
                    class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all outline-none text-gray-900 font-medium" />
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-2xl hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-500/20 transition-all duration-200 text-lg">
                Oppdater passord
            </button>
        </form>

        <div class="mt-8 text-center">
            <a href="/Login?client_id=@Model.ClientId&redirect_uri=@Model.RedirectUri&state=@Model.State&scope=@Model.Scope" 
               class="text-sm font-bold text-gray-400 hover:text-indigo-600 transition-colors uppercase tracking-widest">
                Avbryt
            </a>
        </div>
    </div>
</body>
</html>
