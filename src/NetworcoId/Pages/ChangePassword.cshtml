@page
@model NetworcoId.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Bytt passord";
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NETWORCO - Bytt passord</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Bytt passord</h1>
            <p class="text-gray-600">Du må bytte passord før du kan fortsette</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-6 text-center text-sm">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-4">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="RedirectUri" />
            <input type="hidden" asp-for="State" />
            <input type="hidden" asp-for="Scope" />

            <div>
                <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-700 mb-1">Nåværende passord</label>
                <input type="password" asp-for="CurrentPassword" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
            </div>

            <div class="pt-2">
                <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700 mb-1">Nytt passord</label>
                <input type="password" asp-for="NewPassword" required minlength="12"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                <p class="text-xs text-gray-500 mt-1">Minst 12 tegn, store/små bokstaver og tall</p>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Bekreft nytt passord</label>
                <input type="password" asp-for="ConfirmPassword" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white font-semibold py-3 px-4 rounded-lg hover:bg-indigo-700 transition duration-200 mt-4">
                Oppdater passord
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/Login?client_id=@Model.ClientId&redirect_uri=@Model.RedirectUri&state=@Model.State&scope=@Model.Scope" 
               class="text-sm text-gray-600 hover:text-indigo-600">
                Avbryt og gå til logg inn
            </a>
        </div>
    </div>
</body>
</html>
