@page
@model NetworcoId.Pages.SetPasswordModel
@{
    ViewData["Title"] = "Sett passord";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <!-- Theme Toggle -->
    <div class="fixed top-6 right-6">
        <partial name="_ThemeToggle" />
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-networco-border dark:border-gray-700 max-w-md w-full p-10 transition-colors duration-300">
        <div class="text-center mb-10">
            <h1 class="font-heading text-3xl font-black text-networco-authority-dark dark:text-white tracking-tight mb-2">
                @(Model.AlreadyHasPassword ? "Endre passord" : "Sett passord")
            </h1>
            <p class="text-networco-authority-light dark:text-gray-400 font-medium">
                Velg et passord for å kunne logge inn med e-post i tillegg til BankID
            </p>
        </div>

        @if (Model.Success)
        {
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/30 text-green-700 dark:text-green-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                Passordet ditt er lagret.
                @if (Model.NeedsEmailVerification)
                {
                    <span>Du må bekrefte en e-postadresse før du kan logge inn med passord.</span>
                }
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                    @Model.ErrorMessage
                </div>
            }

            @if (Model.NeedsEmailVerification)
            {
                <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-100 dark:border-amber-800/30 text-amber-700 dark:text-amber-400 rounded-2xl p-4 mb-8 text-sm font-medium">
                    E-postadressen din er ikke bekreftet. Du kan sette et passord nå, men du må bekrefte en e-postadresse før du kan logge inn med e-post og passord.
                </div>
            }

            <form method="post" class="space-y-6">
                <div>
                    <label asp-for="NewPassword" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-2 ml-1">Nytt passord</label>
                    <input type="password" asp-for="NewPassword" required minlength="@Model.MinPasswordLength" autocomplete="new-password"
                        class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium" />
                    <p class="text-[10px] font-bold uppercase tracking-wider text-networco-authority-light/70 dark:text-gray-500 mt-2 px-1">Minst @Model.MinPasswordLength tegn, store/små bokstaver, tall og spesialtegn</p>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-2 ml-1">Bekreft passord</label>
                    <input type="password" asp-for="ConfirmPassword" required autocomplete="new-password"
                        class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium" />
                </div>

                <button type="submit" class="w-full bg-networco-coral text-white font-bold py-4 px-6 rounded-2xl hover:bg-networco-coral-light hover:shadow-lg hover:shadow-networco-coral/30 transition-all duration-200 text-lg">
                    Lagre passord
                </button>
            </form>
        }
    </div>
</div>
