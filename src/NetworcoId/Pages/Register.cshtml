@page
@model NetworcoId.Pages.RegisterModel
@{
    ViewData["Title"] = "Opprett konto";
}

@section Styles {
    <style>
        .bankid-btn {
            background-color: #39134C;
            color: #FFFFFF;
            transition: background-color 0.2s;
        }

        .bankid-btn:hover {
            background-color: #470D70;
        }
        [x-cloak] { display: none !important; }
    </style>
}

<div class="min-h-screen flex items-center justify-center p-4">
    <!-- Theme Toggle -->
    <div class="fixed top-6 right-6">
        <partial name="_ThemeToggle" />
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 max-w-md w-full p-10 transition-colors duration-300">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight mb-2">NETWORCO</h1>
            <p class="text-gray-500 dark:text-gray-400 font-medium">Opprett din konto for å komme i gang</p>
        </div>

        @if (Model.RegistrationSuccess)
        {
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/30 rounded-2xl p-8 mb-6 text-center">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-16 h-16 bg-green-100 dark:bg-green-900/40 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mb-2">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">Sjekk e-posten din!</h3>
                    <p class="text-gray-600 dark:text-gray-400 font-medium leading-relaxed">
                        Vi har sendt en bekreftelseslenke til din e-postadresse. Klikk på lenken for å aktivere kontoen din.
                    </p>
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-4">
                        Ser du den ikke? Sjekk søppelposten.
                    </p>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                    <p>@Model.ErrorMessage</p>
                </div>
            }

            <div class="space-y-3 mb-10">
                <!-- Vipps Register -->
                <div class="h-[52px]">
                    <vipps-mobilepay-button brand="vipps" language="no" verb="register" rounded="true" stretched="true" branded="true">
                    </vipps-mobilepay-button>
                </div>

                <!-- BankID Register -->
                <button type="button" class="bankid-btn w-full flex items-center justify-center gap-3 px-6 py-3 rounded-2xl font-bold text-base h-[52px] shadow-sm">
                    <svg width="28" height="20" viewBox="0 0 119 87" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M35.6071 23.8571H19.9214C17.83 23.8571 16 22.0238 16 19.9286C16 17.8333 17.83 16 19.9214 16H35.6071C37.6986 16 39.5286 17.8333 39.5286 19.9286C39.5286 22.0238 37.6986 23.8571 35.6071 23.8571Z" fill="white" />
                        <path d="M35.6071 55.2857H19.9214C17.83 55.2857 16 53.4524 16 51.3572C16 49.2619 17.83 47.4286 19.9214 47.4286H35.6071C37.6986 47.4286 39.5286 49.2619 39.5286 51.3572C39.5286 53.4524 37.6986 55.2857 35.6071 55.2857Z" fill="white" />
                        <path d="M35.6071 71H19.9214C17.83 71 16 69.1667 16 67.0715C16 64.9762 17.83 63.1429 19.9214 63.1429H35.6071C37.6986 63.1429 39.5286 64.9762 39.5286 67.0715C39.5286 69.1667 37.6986 71 35.6071 71Z" fill="white" />
                        <path d="M66.9786 39.5714H51.2929C49.2014 39.5714 47.3714 37.7381 47.3714 35.6429C47.3714 33.5476 49.2014 31.7143 51.2929 31.7143H66.9786C69.07 31.7143 70.9 33.5476 70.9 35.6429C70.9 37.7381 69.07 39.5714 66.9786 39.5714Z" fill="white" />
                        <path d="M66.9786 55.2857H51.2929C49.2014 55.2857 47.3714 53.4524 47.3714 51.3572C47.3714 49.2619 49.2014 47.4286 51.2929 47.4286H66.9786C69.07 47.4286 70.9 49.2619 70.9 51.3572C70.9 53.4524 69.07 55.2857 66.9786 55.2857Z" fill="white" />
                        <path d="M98.35 23.8571H82.6643C80.5729 23.8571 78.7429 22.0238 78.7429 19.9286C78.7429 17.8333 80.5729 16 82.6643 16H98.35C100.441 16 102.271 17.8333 102.271 19.9286C102.271 22.0238 100.441 23.8571 98.35 23.8571Z" fill="white" />
                        <path d="M98.35 39.5714H82.6643C80.5729 39.5714 78.7429 37.7381 78.7429 35.6429C78.7429 33.5476 80.5729 31.7143 82.6643 31.7143H98.35C100.441 31.7143 102.271 33.5476 102.271 35.6429C102.271 37.7381 100.441 39.5714 98.35 39.5714Z" fill="white" />
                        <path d="M98.35 71H82.6643C80.5729 71 78.7429 69.1667 78.7429 67.0715C78.7429 64.9762 80.5729 63.1429 82.6643 63.1429H98.35C100.441 63.1429 102.271 64.9762 102.271 67.0715C102.271 69.1667 100.441 71 98.35 71Z" fill="white" />
                    </svg>
                    Registrer med BankID
                </button>
            </div>

            <div class="relative my-10">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-100 dark:border-gray-700"></div>
                </div>
                <div class="relative flex justify-center text-xs">
                    <span class="px-4 bg-white dark:bg-gray-800 text-gray-400 font-bold uppercase tracking-widest transition-colors duration-300">eller bruk e-post</span>
                </div>
            </div>

            <form method="post" id="registerForm" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="return_url" value="@Model.ReturnUrl" />
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="firstName" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Fornavn</label>
                        <input type="text" id="firstName" name="firstName" required
                            class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" placeholder="Ola" />
                    </div>
                    <div>
                        <label for="lastName" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Etternavn</label>
                        <input type="text" id="lastName" name="lastName" required
                            class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" placeholder="Nordmann" />
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">E-post</label>
                    <input type="email" id="email" name="email" required
                        class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" placeholder="ola@@networco.dev" />
                </div>

                <div class="space-y-6">
                    <div>
                        <label for="password" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Passord</label>
                        <input type="password" id="password" name="password" required minlength="@Model.MinPasswordLength"
                            class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" placeholder="••••••••" />

                        <!-- Strength Indicator -->
                        <div class="mt-4 space-y-3 px-1">
                            <div class="flex gap-1.5 h-1.5">
                                <div id="strength-1" class="flex-1 rounded-full bg-gray-100 dark:bg-gray-700 transition-colors"></div>
                                <div id="strength-2" class="flex-1 rounded-full bg-gray-100 dark:bg-gray-700 transition-colors"></div>
                                <div id="strength-3" class="flex-1 rounded-full bg-gray-100 dark:bg-gray-700 transition-colors"></div>
                                <div id="strength-4" class="flex-1 rounded-full bg-gray-100 dark:bg-gray-700 transition-colors"></div>
                            </div>
                            <p id="strength-text" class="text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500">Styrke: Ingen</p>
                        </div>

                        <!-- Real-time Requirements -->
                        <ul class="mt-4 space-y-2 px-1">
                            <li id="req-length" class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-wider text-gray-400 transition-colors">
                                <span class="status-icon w-4 h-4 rounded-full border-2 border-current flex items-center justify-center text-[8px]"></span> Minst @Model.MinPasswordLength tegn
                            </li>
                            <li id="req-upper" class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-wider text-gray-400 transition-colors">
                                <span class="status-icon w-4 h-4 rounded-full border-2 border-current flex items-center justify-center text-[8px]"></span> Stor bokstav
                            </li>
                            <li id="req-lower" class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-wider text-gray-400 transition-colors">
                                <span class="status-icon w-4 h-4 rounded-full border-2 border-current flex items-center justify-center text-[8px]"></span> Liten bokstav
                            </li>
                            <li id="req-digit" class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-wider text-gray-400 transition-colors">
                                <span class="status-icon w-4 h-4 rounded-full border-2 border-current flex items-center justify-center text-[8px]"></span> Minst ett tall
                            </li>
                        </ul>
                    </div>
                    <div>
                        <label for="confirmPassword" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Gjenta passord</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="@Model.MinPasswordLength"
                            class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" placeholder="••••••••" />
                        <p id="match-text" class="text-[11px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mt-3 px-1 flex items-center gap-3 transition-colors" style="visibility: hidden;">
                            <span id="match-icon" class="w-4 h-4 rounded-full border-2 border-current flex items-center justify-center text-[8px]"></span> Passordene må være like
                        </p>
                    </div>
                </div>

                <div id="clientErrorMessage" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 text-sm font-medium">
                </div>

                <div class="bg-indigo-50/50 dark:bg-indigo-900/10 border border-indigo-100 dark:border-indigo-800/20 rounded-2xl p-5">
                    <div class="flex gap-3">
                        <span class="text-xl">📧</span>
                        <p class="text-[11px] font-bold uppercase tracking-wider text-indigo-900/60 dark:text-indigo-400/60 leading-relaxed">
                            <strong>E-postbekreftelse</strong><br />
                            Vi sender en bekreftelseslenke for å sikre din identitet.
                        </p>
                    </div>
                </div>

                <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-2xl hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-500/20 transition-all duration-200 text-lg">
                    Opprett konto
                </button>
            </form>

            <div class="mt-10 text-center">
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    Har du allerede en konto?
                    <a href="/Login?return_url=@System.Net.WebUtility.UrlEncode(Model.ReturnUrl)" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-bold ml-1">Logg inn i stedet</a>
                </p>
            </div>
        }

        <div class="mt-10 pt-8 border-t border-gray-100 dark:border-gray-700">
            <p class="text-[10px] leading-relaxed text-center text-gray-400 dark:text-gray-500 font-medium uppercase tracking-wider">
                Sikker registrering fra Networco. Du kan also bruke Vipps og BankID for rask tilgang.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script async type="text/javascript" src="https://checkout.vipps.no/checkout-button/v1/vipps-checkout-button.js"></script>
    <script>
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirmPassword');
        const registerForm = document.getElementById('registerForm');
        const errorDiv = document.getElementById('clientErrorMessage');

        const requirements = {
            length: { el: document.getElementById('req-length'), check: (p) => p.length >= @Model.MinPasswordLength },
            upper: { el: document.getElementById('req-upper'), check: (p) => /[A-Z]/.test(p) },
            lower: { el: document.getElementById('req-lower'), check: (p) => /[a-z]/.test(p) },
            digit: { el: document.getElementById('req-digit'), check: (p) => /[0-9]/.test(p) }
        };

        const strengthBars = [
            document.getElementById('strength-1'),
            document.getElementById('strength-2'),
            document.getElementById('strength-3'),
            document.getElementById('strength-4')
        ];
        const strengthText = document.getElementById('strength-text');
        const matchText = document.getElementById('match-text');
        const matchIcon = document.getElementById('match-icon');

        function updateValidation() {
            const password = passwordInput.value;
            const confirm = confirmInput.value;
            let metCount = 0;

            // Update requirements list
            for (const key in requirements) {
                const req = requirements[key];
                const isMet = req.check(password);
                if (isMet) {
                    req.el.classList.remove('text-gray-400', 'text-red-500');
                    req.el.classList.add('text-green-600');
                    req.el.querySelector('.status-icon').textContent = '✓';
                    req.el.querySelector('.status-icon').classList.remove('border-current');
                    req.el.querySelector('.status-icon').classList.add('bg-green-600', 'border-green-600', 'text-white');
                    metCount++;
                } else {
                    req.el.classList.remove('text-green-600', 'text-red-500');
                    req.el.classList.add('text-gray-400');
                    req.el.querySelector('.status-icon').textContent = '';
                    req.el.querySelector('.status-icon').classList.add('border-current');
                    req.el.querySelector('.status-icon').classList.remove('bg-green-600', 'border-green-600', 'text-white');
                }
            }

            // Update strength indicator
            const strength = calculateStrength(password, metCount);
            updateStrengthUI(strength);

            // Update match indicator — only show when user has started typing in confirm field
            if (confirm) {
                matchText.style.visibility = 'visible';
                if (password === confirm) {
                    matchText.classList.remove('text-gray-400', 'text-red-500');
                    matchText.classList.add('text-green-600');
                    matchIcon.textContent = '✓';
                    matchIcon.classList.remove('border-current');
                    matchIcon.classList.add('bg-green-600', 'border-green-600', 'text-white');
                    matchText.lastChild.textContent = ' Passordene er like';
                } else {
                    matchText.classList.remove('text-gray-400', 'text-green-600');
                    matchText.classList.add('text-red-500');
                    matchIcon.textContent = '✕';
                    matchIcon.classList.remove('border-current');
                    matchIcon.classList.add('bg-red-500', 'border-red-500', 'text-white');
                    matchText.lastChild.textContent = ' Passordene må være like';
                }
            } else {
                matchText.style.visibility = 'hidden';
                matchText.classList.remove('text-green-600', 'text-red-500');
                matchText.classList.add('text-gray-400');
                matchIcon.textContent = '';
                matchIcon.classList.add('border-current');
                matchIcon.classList.remove('bg-green-600', 'border-green-600', 'bg-red-500', 'border-red-500', 'text-white');
            }
        }

        function calculateStrength(p, metCount) {
            if (!p) return 0;

            let score = metCount;
            if (p.length > @Model.MinPasswordLength + 4) score++;
            if (/[^A-Za-z0-9]/.test(p)) score++;

            if (p.length < @Model.MinPasswordLength) return 1;

            if (score <= 2) return 1;
            if (score === 3) return 2;
            if (score === 4) return 3;
            return 4;
        }

        function updateStrengthUI(strength) {
            const colors = ['bg-gray-100', 'bg-red-500', 'bg-orange-500', 'bg-yellow-500', 'bg-green-500'];
            const labels = ['Ingen', 'Svakt', 'Middels', 'Godt', 'Sterkt'];

            strengthBars.forEach((bar, i) => {
                bar.className = `flex-1 rounded-full transition-colors ${i < strength ? colors[strength] : 'bg-gray-100 dark:bg-gray-700'}`;
            });

            strengthText.textContent = `Styrke: ${labels[strength]}`;
            strengthText.className = `text-[10px] font-bold uppercase tracking-wider ${strength > 0 ? colors[strength].replace('bg-', 'text-') : 'text-gray-400 dark:text-gray-500'}`;
        }

        passwordInput.addEventListener('input', updateValidation);
        confirmInput.addEventListener('input', updateValidation);

        registerForm.addEventListener('submit', function (e) {
            const password = passwordInput.value;
            const confirm = confirmInput.value;

            let error = '';

            if (password.length < @Model.MinPasswordLength) {
                error = `Passordet må være minst @Model.MinPasswordLength tegn`;
            } else if (!/[A-Z]/.test(password) || !/[a-z]/.test(password) || !/[0-9]/.test(password)) {
                error = 'Passordet må inneholde minst én stor bokstav, én liten bokstav og ett tall';
            } else if (password !== confirm) {
                error = 'Passordene er ikke like';
            }

            if (error) {
                e.preventDefault();
                errorDiv.textContent = error;
                errorDiv.classList.remove('hidden');

                // Highlight failed requirements in red
                for (const key in requirements) {
                    const req = requirements[key];
                    if (!req.check(password)) {
                        req.el.classList.add('text-red-500');
                    }
                }
            } else {
                errorDiv.classList.add('hidden');
            }
        });

        // Custom Norwegian validation messages for HTML5 popups
        const inputs = document.querySelectorAll('input[required], input[type="email"]');
        inputs.forEach(input => {
            input.addEventListener('invalid', function (e) {
                input.setCustomValidity(''); // Reset first
                if (input.validity.valueMissing) {
                    input.setCustomValidity('Vennligst fyll ut dette feltet');
                } else if (input.validity.typeMismatch && input.type === 'email') {
                    input.setCustomValidity('Vennligst oppgi en gyldig e-postadresse');
                } else if (input.validity.tooShort) {
                    input.setCustomValidity('Vennligst bruk minst ' + input.minLength + ' tegn');
                }
            });
            input.addEventListener('input', function (e) {
                input.setCustomValidity('');
            });
        });
    </script>
}
