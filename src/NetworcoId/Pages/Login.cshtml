@page
@model NetworcoId.Pages.LoginModel
@using System.Web

@section Styles {
    <style>
        .bankid-btn {
            background-color: #39134C;
            color: #FFFFFF;
            transition: background-color 0.2s;
        }
        .bankid-btn:hover {
            background-color: #470D70;
        }
        [x-cloak] { display: none !important; }
    </style>
}

<div class="min-h-screen flex items-center justify-center p-4">
    <!-- Theme Toggle -->
    <div class="fixed top-6 right-6">
        <partial name="_ThemeToggle" />
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-networco-border dark:border-gray-700 max-w-md w-full p-10 transition-colors duration-300">
        <div class="text-center mb-10">
            <h1 class="font-heading text-3xl font-black text-networco-authority-dark dark:text-white tracking-tight mb-2">NETWORCO</h1>
            <p class="text-networco-authority-light dark:text-gray-400 font-medium">Logg inn med din konto</p>
        </div>

        @if (Model.VerificationEmailResent)
        {
            <div class="bg-networco-baby-50 dark:bg-green-900/20 border border-networco-primary/20 dark:border-green-800/30 text-networco-primary dark:text-green-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                Vi har sendt en ny bekreftelseslenke hvis e-postadressen er registrert. Sjekk innboksen din.
            </div>
        }
        else if (Model.RequiresEmailVerification)
        {
            <div class="bg-networco-baby-50 dark:bg-yellow-900/20 border border-networco-primary/20 dark:border-yellow-800/30 text-networco-authority-dark dark:text-yellow-200 rounded-2xl p-4 mb-6 text-sm">
                <p class="font-bold mb-2">@Model.ErrorMessage</p>
                <p class="mb-3 text-networco-text dark:text-gray-400">
                    Klikk under for å få tilsendt en ny bekreftelseslenke (gyldig i 30 minutter).
                </p>
                <form method="post" asp-page-handler="ResendVerification">
                    <input type="hidden" name="resendEmail" value="@Model.UnverifiedEmail" />
                    <input type="hidden" name="client_id" value="@Model.ClientId" />
                    <input type="hidden" name="redirect_uri" value="@Model.RedirectUri" />
                    <input type="hidden" name="state" value="@Model.State" />
                    <input type="hidden" name="scope" value="@Model.Scope" />
                    <button type="submit" class="w-full bg-networco-coral text-white font-bold py-3 px-6 rounded-2xl hover:bg-networco-coral-light hover:shadow-lg hover:shadow-networco-coral/30 transition-all duration-200">
                        Send ny bekreftelseslenke
                    </button>
                </form>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                @if (Model.IsClientError)
                {
                    <div class="flex flex-col items-center gap-2">
                        <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <span class="font-bold text-networco-authority-dark dark:text-white">Systemfeil</span>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }
                else
                {
                    @Model.ErrorMessage
                }
            </div>
        }

        @if (!Model.IsClientError)
        {
            @* Vipps login is intentionally hidden until implemented. *@
            @* BankID login is intentionally hidden on the login page (moved to youth
               registration, see issue #104). IDURA_ENABLED still controls the IDura
               integration itself (verify-to-link), only this button is removed here. *@

            <form method="post" id="loginForm" class="space-y-6">
                <input type="hidden" asp-for="scope" name="scope" />
                <input type="hidden" asp-for="nonce" name="nonce" />
                <input type="hidden" asp-for="client_id" name="client_id" />
                <input type="hidden" asp-for="redirect_uri" name="redirect_uri" />
                <input type="hidden" asp-for="state" name="state" />
                <input type="hidden" asp-for="code_challenge" name="code_challenge" />
                <input type="hidden" asp-for="code_challenge_method" name="code_challenge_method" />

                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-2 ml-1">E-post</label>
                    <input type="email" asp-for="Email" required autocomplete="username" placeholder="din.epost@eksempel.no"
                        class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium placeholder:text-networco-authority-light/50" />
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2 ml-1">
                        <label asp-for="Password" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest">Passord</label>
                        <a asp-page="/Auth/ForgotPassword"
                           asp-route-client_id="@Model.client_id"
                           asp-route-redirect_uri="@Model.redirect_uri"
                           asp-route-state="@Model.state"
                           asp-route-scope="@Model.scope"
                           asp-route-code_challenge="@Model.code_challenge"
                           asp-route-code_challenge_method="@Model.code_challenge_method"
                           class="text-xs font-bold text-networco-primary dark:text-networco-baby-200 hover:text-networco-primary-dark dark:hover:text-white">Glemt?</a>
                    </div>
                    <input type="password" asp-for="Password" required autocomplete="current-password" placeholder="••••••••"
                        class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium placeholder:text-networco-authority-light/50" />
                </div>

                <button type="submit" class="w-full bg-networco-coral text-white font-bold py-4 px-6 rounded-2xl hover:bg-networco-coral-light hover:shadow-lg hover:shadow-networco-coral/30 transition-all duration-200 text-lg">
                    Logg inn
                </button>
            </form>

            <div class="text-center text-sm font-medium text-networco-authority-light dark:text-gray-400 mt-10">
                <text>Ny hos NETWORCO?</text>
                <a href="/Register?return_url=@(HttpUtility.UrlEncode(Request.Path + Request.QueryString))"
                    class="text-networco-primary dark:text-networco-baby-200 hover:text-networco-primary-dark dark:hover:text-white font-bold ml-1">Opprett konto</a>
            </div>

            @if (Model.TestUsers != null && Model.TestUsers.Any())
            {
                <div class="mt-12 pt-8 border-t border-networco-border dark:border-gray-700">
                    <h3 class="text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-4">Testbrukere</h3>
                    <div class="grid grid-cols-1 gap-3">
                        @foreach (var user in Model.TestUsers)
                        {
                            <div class="p-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl cursor-pointer hover:bg-white dark:hover:bg-gray-950 hover:border-networco-primary/30 dark:hover:border-networco-primary hover:shadow-sm transition-all duration-200 group"
                                onclick="fillCredentials('@user.Email', '@user.Password')">
                                <div class="font-bold text-networco-authority-dark dark:text-white group-hover:text-networco-primary dark:group-hover:text-networco-baby-200 transition-colors">@user.FirstName @user.LastName</div>
                                <div class="text-xs text-networco-authority-light/80 font-medium">@user.Email</div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="mt-8 text-center">
                <a href="/" class="text-networco-primary dark:text-networco-baby-200 hover:text-networco-primary-dark dark:hover:text-white font-bold">Gå tilbake til forsiden</a>
            </div>
        }

        <div class="mt-10 pt-8 border-t border-networco-border dark:border-gray-700">
            <p class="text-[10px] leading-relaxed text-center text-networco-authority-light/70 font-medium uppercase tracking-wider">
                Sikker pålogging fra Networco.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCredentials(email, password) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = password;
        }

        // Custom Norwegian validation messages for HTML5 popups
        const inputs = document.querySelectorAll('input[required], input[type="email"]');
        inputs.forEach(input => {
            input.addEventListener('invalid', function (e) {
                input.setCustomValidity(''); // Reset first
                if (input.validity.valueMissing) {
                    input.setCustomValidity('Vennligst fyll ut dette feltet');
                } else if (input.validity.typeMismatch && input.type === 'email') {
                    input.setCustomValidity('Vennligst oppgi en gyldig e-postadresse');
                }
            });
            input.addEventListener('input', function (e) {
                input.setCustomValidity('');
            });
        });
    </script>
}
