@page
@model NetworcoId.Pages.VerifyModel
@{
    ViewData["Title"] = Model.IsVerified ? "E-post bekreftet" : "Bekrefter...";
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NETWORCO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    @if (Model.IsVerified && !string.IsNullOrEmpty(Model.AuthorizationUrl))
    {
        <meta http-equiv="refresh" content="2;url=@Model.AuthorizationUrl" />
    }
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 max-w-md w-full p-10">
        @if (Model.IsVerified)
        {
            <div class="text-center">
                <div class="mx-auto w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-3">Suksess!</h1>
                <p class="text-gray-500 font-medium mb-8 leading-relaxed">Din e-post er bekreftet og kontoen din er nå aktivert.</p>
                <div class="flex items-center justify-center gap-3 py-4 px-6 bg-gray-50 rounded-2xl border border-gray-100">
                    <div class="w-2 h-2 bg-indigo-600 rounded-full animate-pulse"></div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Logger deg inn...</p>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="text-center">
                <div class="mx-auto w-20 h-20 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-3">Oisann!</h1>
                <p class="text-red-500 font-bold mb-10 leading-relaxed">@Model.ErrorMessage</p>
                <a href="/Login" class="inline-block w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-2xl hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-500/20 transition-all duration-200 text-lg">
                    Gå til innlogging
                </a>
            </div>
        }
        else
        {
            <div class="text-center">
                <div class="mx-auto w-20 h-20 bg-indigo-100 rounded-full flex items-center justify-center mb-6">
                    <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-600 border-t-transparent"></div>
                </div>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-3">Bekrefter...</h1>
                <p class="text-gray-500 font-medium mb-6">Et lite øyeblikk mens vi verifiserer din identitet.</p>
            </div>
        }
    </div>
</body>
</html>
