@page
@model NetworcoId.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Tilbakestill passord";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <!-- Theme Toggle -->
    <div class="fixed top-6 right-6">
        <partial name="_ThemeToggle" />
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-networco-border dark:border-gray-700 max-w-md w-full p-10 transition-colors duration-300">
    <div class="text-center mb-10">
        <h1 class="font-heading text-3xl font-black text-networco-authority-dark dark:text-white tracking-tight mb-2">NETWORCO</h1>
        <p class="text-networco-authority-light dark:text-gray-400 font-medium">Tilbakestill passord</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/30 text-green-700 dark:text-green-400 rounded-2xl p-8 mb-8 text-center">
            <div class="flex flex-col items-center gap-4">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mb-2">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <p class="font-bold text-networco-authority-dark dark:text-white">Suksess!</p>
                <p class="text-networco-text dark:text-gray-400 font-medium leading-relaxed">
                    @Model.SuccessMessage
                </p>
            </div>
        </div>
        <div class="text-center">
            <a href="@Model.LoginUrl" class="w-full inline-block bg-networco-coral text-white font-bold py-4 px-6 rounded-2xl hover:bg-networco-coral-light hover:shadow-lg hover:shadow-networco-coral/30 transition-all duration-200 text-lg">
                Logg inn nå
            </a>
        </div>
    }
    else
    {
        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" name="return_url" value="@Model.ReturnUrl" />

            <div>
                <label asp-for="NewPassword" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-2 ml-1">Nytt passord</label>
                <input type="password" asp-for="NewPassword" required placeholder="••••••••" minlength="@Model.MinPasswordLength"
                    class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium placeholder:text-networco-authority-light/50" />
                <p class="text-[10px] font-bold uppercase tracking-wider text-networco-authority-light/70 dark:text-gray-500 mt-2 px-1">Minst @Model.MinPasswordLength tegn</p>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-bold text-networco-authority-light/80 uppercase tracking-widest mb-2 ml-1">Bekreft nytt passord</label>
                <input type="password" asp-for="ConfirmPassword" required placeholder="••••••••"
                    class="w-full px-5 py-4 bg-networco-baby-50 dark:bg-gray-900 border border-networco-border dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-networco-primary/15 focus:border-networco-primary focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-networco-text dark:text-white font-medium placeholder:text-networco-authority-light/50" />
            </div>

            <button type="submit" class="w-full bg-networco-coral text-white font-bold py-4 px-6 rounded-2xl hover:bg-networco-coral-light hover:shadow-lg hover:shadow-networco-coral/30 transition-all duration-200 text-lg">
                Oppdater passord
            </button>
        </form>
    }
    </div>
</div>
