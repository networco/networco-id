@page
@model NetworcoId.Pages.Auth.ResetPasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tilbakestill passord - NETWORCO</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">NETWORCO</h1>
            <p class="text-gray-600">Tilbakestill passord</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-6 text-center text-sm">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-6 text-center text-sm">
                @Model.SuccessMessage
            </div>
            <div class="mt-8 text-center">
                <a asp-page="/Login" class="w-full inline-block bg-gray-800 text-white font-semibold py-3 px-4 rounded-lg hover:bg-gray-900 transition duration-200">
                    Gå til innlogging
                </a>
            </div>
        }
        else
        {
            <form method="post" class="space-y-4">
                <input type="hidden" asp-for="Token" />

                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700 mb-1">Nytt passord</label>
                    <input type="password" asp-for="NewPassword" required placeholder="••••••••" minlength="@Model.MinPasswordLength"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    <p class="text-xs text-gray-500 mt-1">Minst @Model.MinPasswordLength tegn</p>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Bekreft nytt passord</label>
                    <input type="password" asp-for="ConfirmPassword" required placeholder="••••••••"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <button type="submit" class="w-full bg-gray-800 text-white font-semibold py-3 px-4 rounded-lg hover:bg-gray-900 transition duration-200">
                    Oppdater passord
                </button>
            </form>
        }
    </div>
</body>

</html>
