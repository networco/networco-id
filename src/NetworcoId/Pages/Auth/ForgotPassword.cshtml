@page
@model NetworcoId.Pages.Auth.ForgotPasswordModel
@using System.Web
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Glemt passord - NETWORCO</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">NETWORCO</h1>
            <p class="text-gray-600">Glemt passord</p>
        </div>

        <div class="text-sm text-gray-600 mb-6 text-center">
            Skriv inn din e-postadresse, så sender vi deg en lenke for å tilbakestille passordet ditt.
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-6 text-center text-sm">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-6 text-center text-sm">
                @Model.SuccessMessage
            </div>
            <div class="mt-8 text-center">
                <a asp-page="/Login" 
                   asp-route-client_id="@Model.client_id" 
                   asp-route-redirect_uri="@Model.redirect_uri"
                   asp-route-state="@Model.state"
                   asp-route-scope="@Model.scope"
                   class="text-indigo-600 hover:text-indigo-500 font-medium">Tilbake til innlogging</a>
            </div>
        }
        else
        {
            <form method="post" class="space-y-4">
                <input type="hidden" name="client_id" value="@Model.client_id" />
                <input type="hidden" name="redirect_uri" value="@Model.redirect_uri" />
                <input type="hidden" name="state" value="@Model.state" />
                <input type="hidden" name="scope" value="@Model.scope" />

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">E-post</label>
                    <input type="email" asp-for="Email" required placeholder="din.epost@eksempel.no"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <button type="submit" class="w-full bg-gray-800 text-white font-semibold py-3 px-4 rounded-lg hover:bg-gray-900 transition duration-200">
                    Send tilbakestillingslenke
                </button>

                <div class="text-center mt-6">
                    <a asp-page="/Login" 
                       asp-route-client_id="@Model.client_id" 
                       asp-route-redirect_uri="@Model.redirect_uri"
                       asp-route-state="@Model.state"
                       asp-route-scope="@Model.scope"
                       class="text-sm text-indigo-600 hover:text-indigo-500 font-medium">Tilbake til innlogging</a>
                </div>
            </form>
        }

        <div class="mt-8 pt-6 border-t border-gray-200 text-center">
            <a href="/Register?return_url=@(HttpUtility.UrlEncode(Url.Page("/Login", new { client_id = Model.client_id, redirect_uri = Model.redirect_uri, state = Model.state, scope = Model.scope })))"
                class="text-sm text-gray-600 hover:text-indigo-500">Trenger du en konto? Opprett konto</a>
        </div>
    </div>
</body>

</html>
