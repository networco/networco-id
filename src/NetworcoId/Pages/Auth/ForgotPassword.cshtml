@page
@model NetworcoId.Pages.Auth.ForgotPasswordModel
@using System.Web
@{
    ViewData["Title"] = "Glemt passord";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <!-- Theme Toggle -->
    <div class="fixed top-6 right-6">
        <partial name="_ThemeToggle" />
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 max-w-md w-full p-10 transition-colors duration-300">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight mb-2">NETWORCO</h1>
            <p class="text-gray-500 dark:text-gray-400 font-medium">Glemt passord</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 text-red-700 dark:text-red-400 rounded-2xl p-4 mb-8 text-center text-sm font-medium">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/30 text-green-700 dark:text-green-400 rounded-2xl p-8 mb-8 text-center">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-16 h-16 bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mb-2">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <p class="font-bold text-gray-900 dark:text-white">E-post sendt!</p>
                    <p class="text-gray-600 dark:text-gray-400 font-medium leading-relaxed">
                        @Model.SuccessMessage
                    </p>
                </div>
            </div>
            <div class="text-center">
                <a asp-page="/Login" 
                   asp-route-client_id="@Model.client_id" 
                   asp-route-redirect_uri="@Model.redirect_uri"
                   asp-route-state="@Model.state"
                   asp-route-scope="@Model.scope"
                   class="text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 uppercase tracking-widest">Tilbake til innlogging</a>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-500 dark:text-gray-400 font-medium mb-10 text-center leading-relaxed">
                Skriv inn din e-postadresse, så sender vi deg en lenke for å tilbakestille passordet ditt.
            </p>

            <form method="post" class="space-y-6">
                <input type="hidden" name="client_id" value="@Model.client_id" />
                <input type="hidden" name="redirect_uri" value="@Model.redirect_uri" />
                <input type="hidden" name="state" value="@Model.state" />
                <input type="hidden" name="scope" value="@Model.scope" />

                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">E-post</label>
                    <input type="email" asp-for="Email" required placeholder="din.epost@eksempel.no"
                        class="w-full px-5 py-4 bg-gray-100 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white dark:focus:bg-gray-950 transition-all outline-none text-gray-900 dark:text-white font-medium placeholder:text-gray-400" />
                </div>

                <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-2xl hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-500/20 transition-all duration-200 text-lg">
                    Send lenke
                </button>

                <div class="text-center mt-8">
                    <a asp-page="/Login" 
                       asp-route-client_id="@Model.client_id" 
                       asp-route-redirect_uri="@Model.redirect_uri"
                       asp-route-state="@Model.state"
                       asp-route-scope="@Model.scope"
                       class="text-sm font-bold text-gray-400 dark:text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors uppercase tracking-widest">Tilbake</a>
                </div>
            </form>
        }

        <div class="mt-12 pt-8 border-t border-gray-100 dark:border-gray-700 text-center">
            <a href="/Register?return_url=@(HttpUtility.UrlEncode(Url.Page("/Login", new { client_id = Model.client_id, redirect_uri = Model.redirect_uri, state = Model.state, scope = Model.scope })))"
                class="text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">Ny bruker? Opprett konto</a>
        </div>
    </div>
</div>
