{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Admin": {
    "AccessKey": "secret"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "networco-auth-dev",
      "Audience": "networco-dev",
      "SigningKey": "dev-secret-key-change-in-production-min-32-chars"
    }
  },
  "NetworcoId": {
    "BaseUrl": "http://localhost:5200",
    "Issuer": "networco-auth-dev",
    "Audience": "networco-dev",
    "Secret": "dev-secret-key-change-in-production-min-32-chars",
    "TrustedExchangeClients": ["networco-dev-api"],
    "AllowedClients": [
      {
        "ClientId": "networco-web-local-dev",
        "ClientSecret": "dev-secret-123",
        "Name": "Networco Web (Local Dev)",
        "RedirectUris": [
          "http://localhost:3000/auth/callback",
          "http://localhost:3000/api/auth/callback/networco"
        ],
        "AllowedScopes": ["openid", "profile", "email", "offline_access"]
      },
      {
        "ClientId": "networco-dev-api",
        "ClientSecret": "dev-secret-api-not-for-production",
        "Name": "Networco API (Development)",
        "RedirectUris": [],
        "AllowedScopes": ["api"]
      }
    ]
  },
  "Nats": {
    "Url": "nats://networco:networco-local-secret@localhost:4222",
    "CredentialsFile": "ngs-test-api.creds"
  }
}