{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Use this for debugging - stops cleanly when debugger detaches
            "name": "NetworcoId: Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build:networcoid",
            "program": "${workspaceFolder}/src/NetworcoId/bin/Debug/net10.0/NetworcoId.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/NetworcoId",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            // Use this for debugging - stops cleanly when debugger detaches
            "name": "Worker: Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build:worker",
            "program": "${workspaceFolder}/src/NetworcoId.Worker/bin/Debug/net10.0/NetworcoId.Worker.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/NetworcoId.Worker",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "NetworcoId Full Debug",
            "configurations": ["NetworcoId: Debug", "Worker: Debug"]
        }
    ]
}